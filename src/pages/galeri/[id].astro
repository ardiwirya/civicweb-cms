---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/galeri");
}

const { data: album } = await supabase
  .from("gallery_albums")
  .select("title, description")
  .eq("id", id)
  .single();

if (!album) {
  return Astro.redirect("/galeri");
}

const { data: photos } = await supabase
  .from("gallery_photos")
  .select("id, image_url, caption")
  .eq("album_id", id)
  .order("order_index", { ascending: true });
---

<BaseLayout title={album.title}>
  <SectionHeader title={album.title} subtitle={album.description ?? undefined} />

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {photos?.length ? (
      <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {photos.map((photo) => (
          <figure>
            <img src={photo.image_url} alt={photo.caption ?? album.title} class="h-40 w-full rounded-md object-cover" />
            {photo.caption && <figcaption class="mt-1 text-xs text-slate-500 dark:text-slate-400">{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada foto di album ini." />
    )}
  </section>
</BaseLayout>
