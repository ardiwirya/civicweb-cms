---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import ContactForm from "@/components/public/ContactForm";
import { getInstitutionProfile } from "@/lib/config/site";

const institution = await getInstitutionProfile();
---

<BaseLayout title="Kontak" institution={institution}>
  <SectionHeader title="Kontak Kami" />

  <section class="mx-auto max-w-4xl px-4 pb-16">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="mb-3 font-semibold text-slate-900 dark:text-white">Informasi Kontak</h2>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          {institution.address && <li>{institution.address}</li>}
          {institution.phone && <li>Telepon: {institution.phone}</li>}
          {institution.email && <li>Email: {institution.email}</li>}
        </ul>
      </div>

      <div>
        <h2 class="mb-3 font-semibold text-slate-900 dark:text-white">Kirim Pesan</h2>
        <!-- client:load karena form ini action utama halaman, langsung interaktif -->
        <ContactForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
