---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase/client";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/berita");
}

const { data: item } = await supabase
  .from("news")
  .select("title, content, cover_image_url, category, status, published_at")
  .eq("slug", slug)
  .single();

// Tidak difilter status di query supaya admin yang login bisa preview draft
// (RLS di database yang menentukan: publik hanya boleh baca yang published,
// admin/super_admin boleh baca semua status). Pengunjung anonim otomatis
// tidak akan pernah dapat baris berstatus draft karena RLS menolaknya.
if (!item) {
  return Astro.redirect("/berita");
}

const publishedDate = item.published_at
  ? new Date(item.published_at).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" })
  : null;
---

<BaseLayout title={item.title} description={item.title}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    {item.status === "draft" && (
      <div class="mb-4 rounded-md bg-amber-100 px-3 py-2 text-sm text-amber-800">
        Pratinjau — berita ini belum diterbitkan dan tidak terlihat oleh pengunjung.
      </div>
    )}
    {item.category && (
      <span class="text-xs font-medium uppercase text-brand-primary">{item.category}</span>
    )}
    <h1 class="mt-1 text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">{item.title}</h1>
    {publishedDate && <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{publishedDate}</p>}

    {item.cover_image_url && (
      <img src={item.cover_image_url} alt={item.title} class="my-6 w-full rounded-lg object-cover" />
    )}

    <div class="prose prose-slate max-w-none whitespace-pre-line dark:prose-invert">
      {item.content}
    </div>
  </article>
</BaseLayout>
