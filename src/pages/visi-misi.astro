---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getInstitutionProfile } from "@/lib/config/site";

const institution = await getInstitutionProfile();
---

<BaseLayout title="Visi & Misi" institution={institution}>
  <SectionHeader title="Visi & Misi" />

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <div class="mb-8 rounded-lg border border-slate-200 p-6 dark:border-slate-800">
      <h2 class="mb-2 font-semibold text-slate-900 dark:text-white">Visi</h2>
      <p class="text-slate-700 dark:text-slate-300">
        {institution.vision ?? "Visi belum diatur oleh admin."}
      </p>
    </div>

    <div class="rounded-lg border border-slate-200 p-6 dark:border-slate-800">
      <h2 class="mb-2 font-semibold text-slate-900 dark:text-white">Misi</h2>
      <p class="whitespace-pre-line text-slate-700 dark:text-slate-300">
        {institution.mission ?? "Misi belum diatur oleh admin."}
      </p>
    </div>
  </section>
</BaseLayout>
