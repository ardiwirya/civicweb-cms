---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: events } = await supabase
  .from("agenda_events")
  .select("id, title, description, location, start_at")
  .eq("status", "published")
  .gte("start_at", new Date().toISOString())
  .order("start_at", { ascending: true });

function formatDate(value: string) {
  return new Date(value).toLocaleDateString("id-ID", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
---

<BaseLayout title="Agenda">
  <SectionHeader title="Agenda Kegiatan" subtitle="Jadwal kegiatan mendatang" />

  <section class="mx-auto max-w-3xl px-4 pb-16">
    {events?.length ? (
      <div class="space-y-4">
        {events.map((item) => (
          <div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            <h2 class="font-medium text-slate-900 dark:text-white">{item.title}</h2>
            <p class="mt-1 text-sm text-brand-primary">{formatDate(item.start_at)}</p>
            {item.location && <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Lokasi: {item.location}</p>}
            {item.description && <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{item.description}</p>}
          </div>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada agenda mendatang." />
    )}
  </section>
</BaseLayout>
