---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: newsList } = await supabase
  .from("news")
  .select("id, title, slug, excerpt, cover_image_url, category, published_at")
  .eq("status", "published")
  .order("published_at", { ascending: false });
---

<BaseLayout title="Berita">
  <SectionHeader title="Berita" />

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {newsList?.length ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {newsList.map((item) => (
          <a href={`/berita/${item.slug}`} class="block rounded-lg border border-slate-200 p-4 hover:border-brand-primary dark:border-slate-800">
            {item.cover_image_url && (
              <img src={item.cover_image_url} alt={item.title} class="mb-3 h-40 w-full rounded-md object-cover" />
            )}
            {item.category && (
              <span class="text-xs font-medium uppercase text-brand-primary">{item.category}</span>
            )}
            <h2 class="mt-1 font-medium text-slate-900 dark:text-white">{item.title}</h2>
            {item.excerpt && <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.excerpt}</p>}
          </a>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada berita yang dipublikasikan." />
    )}
  </section>
</BaseLayout>
