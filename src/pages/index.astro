---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getInstitutionProfile } from "@/lib/config/site";
import { supabase } from "@/lib/supabase/client";

const institution = await getInstitutionProfile();

const [{ data: latestNews }, { data: pinnedAnnouncements }] = await Promise.all([
  supabase
    .from("news")
    .select("id, title, slug, excerpt, cover_image_url, published_at")
    .eq("status", "published")
    .order("published_at", { ascending: false })
    .limit(3),
  supabase
    .from("announcements")
    .select("id, title, published_at")
    .eq("status", "published")
    .order("is_pinned", { ascending: false })
    .order("published_at", { ascending: false })
    .limit(4),
]);
---

<BaseLayout title="Beranda" institution={institution}>
  <section class="bg-brand-primary/5 dark:bg-brand-primary/10">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl">
        {institution.hero_title ?? `Selamat Datang di ${institution.name}`}
      </h1>
      {institution.hero_subtitle && (
        <p class="mx-auto mt-4 max-w-2xl text-slate-600 dark:text-slate-300">
          {institution.hero_subtitle}
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-6 text-xl font-semibold text-slate-900 dark:text-white">Berita Terbaru</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      {latestNews?.map((item) => (
        <a href={`/berita/${item.slug}`} class="block rounded-lg border border-slate-200 p-4 hover:border-brand-primary dark:border-slate-800">
          {item.cover_image_url && (
            <img src={item.cover_image_url} alt={item.title} class="mb-3 h-40 w-full rounded-md object-cover" />
          )}
          <h3 class="font-medium text-slate-900 dark:text-white">{item.title}</h3>
          {item.excerpt && <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.excerpt}</p>}
        </a>
      ))}
      {!latestNews?.length && (
        <p class="text-sm text-slate-500 dark:text-slate-400">Belum ada berita yang dipublikasikan.</p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16">
    <h2 class="mb-6 text-xl font-semibold text-slate-900 dark:text-white">Pengumuman</h2>
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {pinnedAnnouncements?.map((item) => (
        <li class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">{item.title}</li>
      ))}
      {!pinnedAnnouncements?.length && (
        <li class="px-4 py-3 text-sm text-slate-500 dark:text-slate-400">Belum ada pengumuman.</li>
      )}
    </ul>
  </section>
</BaseLayout>
