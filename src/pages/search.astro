---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const query = Astro.url.searchParams.get("q")?.trim() ?? "";

let newsResults: { id: string; title: string; slug: string; excerpt: string | null }[] = [];
let announcementResults: { id: string; title: string; content: string }[] = [];

if (query) {
  const [newsRes, announcementRes] = await Promise.all([
    supabase
      .from("news")
      .select("id, title, slug, excerpt")
      .eq("status", "published")
      .ilike("title", `%${query}%`)
      .limit(10),
    supabase
      .from("announcements")
      .select("id, title, content")
      .eq("status", "published")
      .ilike("title", `%${query}%`)
      .limit(10),
  ]);
  newsResults = newsRes.data ?? [];
  announcementResults = announcementRes.data ?? [];
}

const totalResults = newsResults.length + announcementResults.length;
---

<BaseLayout title="Pencarian">
  <SectionHeader title="Pencarian" subtitle={query ? `Hasil untuk "${query}"` : "Masukkan kata kunci pencarian"} />

  <section class="mx-auto max-w-3xl px-4 pb-16">
    <form method="get" class="mb-8 flex gap-2">
      <input
        type="text"
        name="q"
        value={query}
        placeholder="Cari berita, pengumuman..."
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700 dark:bg-slate-900"
      />
      <button type="submit" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-medium text-white">
        Cari
      </button>
    </form>

    {query && (
      totalResults > 0 ? (
        <div class="space-y-8">
          {newsResults.length > 0 && (
            <div>
              <h2 class="mb-3 font-semibold text-slate-900 dark:text-white">Berita</h2>
              <div class="space-y-2">
                {newsResults.map((item) => (
                  <a href={`/berita/${item.slug}`} class="block rounded-lg border border-slate-200 p-3 hover:border-brand-primary dark:border-slate-800">
                    <p class="font-medium text-slate-900 dark:text-white">{item.title}</p>
                    {item.excerpt && <p class="text-sm text-slate-600 dark:text-slate-400">{item.excerpt}</p>}
                  </a>
                ))}
              </div>
            </div>
          )}

          {announcementResults.length > 0 && (
            <div>
              <h2 class="mb-3 font-semibold text-slate-900 dark:text-white">Pengumuman</h2>
              <div class="space-y-2">
                {announcementResults.map((item) => (
                  <div class="rounded-lg border border-slate-200 p-3 dark:border-slate-800">
                    <p class="font-medium text-slate-900 dark:text-white">{item.title}</p>
                    <p class="text-sm text-slate-600 dark:text-slate-400">{item.content}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      ) : (
        <EmptyState message={`Tidak ditemukan hasil untuk "${query}".`} />
      )
    )}
  </section>
</BaseLayout>
