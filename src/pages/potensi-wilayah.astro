---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: potentials } = await supabase
  .from("regional_potentials")
  .select("id, title, description, category, image_url")
  .order("created_at", { ascending: false });
---

<BaseLayout title="Potensi Wilayah">
  <SectionHeader title="Potensi Wilayah" />

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {potentials?.length ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {potentials.map((item) => (
          <div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            {item.image_url && (
              <img src={item.image_url} alt={item.title} class="mb-3 h-40 w-full rounded-md object-cover" />
            )}
            {item.category && <span class="text-xs font-medium uppercase text-brand-primary">{item.category}</span>}
            <h2 class="mt-1 font-medium text-slate-900 dark:text-white">{item.title}</h2>
            {item.description && <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{item.description}</p>}
          </div>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada data potensi wilayah." />
    )}
  </section>
</BaseLayout>
