---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: attractions } = await supabase
  .from("attractions")
  .select("id, name, description, image_url, location, category")
  .order("created_at", { ascending: false });
---

<BaseLayout title="Wisata">
  <SectionHeader title="Wisata" subtitle="Destinasi menarik di wilayah ini" />

  <section class="mx-auto max-w-6xl px-4 pb-16">
    {attractions?.length ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {attractions.map((item) => (
          <div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            {item.image_url && (
              <img src={item.image_url} alt={item.name} class="mb-3 h-40 w-full rounded-md object-cover" />
            )}
            {item.category && <span class="text-xs font-medium uppercase text-brand-primary">{item.category}</span>}
            <h2 class="mt-1 font-medium text-slate-900 dark:text-white">{item.name}</h2>
            {item.location && <p class="text-sm text-slate-500 dark:text-slate-400">{item.location}</p>}
            {item.description && <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{item.description}</p>}
          </div>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada data wisata." />
    )}
  </section>
</BaseLayout>
