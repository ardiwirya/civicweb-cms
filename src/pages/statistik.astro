---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: stats } = await supabase
  .from("statistics")
  .select("id, label, value, unit, category, year")
  .order("category", { ascending: true });

const grouped = (stats ?? []).reduce<Record<string, typeof stats>>((acc, item) => {
  const key = item.category ?? "Umum";
  acc[key] = acc[key] ? [...acc[key], item] : [item];
  return acc;
}, {});
---

<BaseLayout title="Statistik">
  <SectionHeader title="Statistik" />

  <section class="mx-auto max-w-4xl px-4 pb-16">
    {Object.keys(grouped).length ? (
      Object.entries(grouped).map(([category, items]) => (
        <div class="mb-8">
          <h2 class="mb-3 font-semibold text-slate-900 dark:text-white">{category}</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {items!.map((item) => (
              <div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {item.label} {item.year && `(${item.year})`}
                </p>
                <p class="mt-1 text-2xl font-semibold text-slate-900 dark:text-white">
                  {item.value.toLocaleString("id-ID")} <span class="text-sm font-normal">{item.unit}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      ))
    ) : (
      <EmptyState message="Belum ada data statistik." />
    )}
  </section>
</BaseLayout>
