---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import EmptyState from "@/components/ui/EmptyState.astro";
import { supabase } from "@/lib/supabase/client";

const { data: faqs } = await supabase
  .from("faqs")
  .select("id, question, answer")
  .order("order_index", { ascending: true });
---

<BaseLayout title="FAQ">
  <SectionHeader title="Pertanyaan yang Sering Diajukan" />

  <section class="mx-auto max-w-3xl px-4 pb-16">
    {faqs?.length ? (
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            <summary class="cursor-pointer font-medium text-slate-900 dark:text-white">{faq.question}</summary>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{faq.answer}</p>
          </details>
        ))}
      </div>
    ) : (
      <EmptyState message="Belum ada FAQ." />
    )}
  </section>
</BaseLayout>
