---
import type { InstitutionProfile } from "@/lib/config/site";

interface Props {
  institution: InstitutionProfile;
}

const { institution } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <h3 class="font-semibold text-slate-900 dark:text-white">{institution.name}</h3>
        {institution.address && <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{institution.address}</p>}
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-white">Kontak</h3>
        <ul class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-400">
          {institution.phone && <li>{institution.phone}</li>}
          {institution.email && <li>{institution.email}</li>}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-slate-900 dark:text-white">Media Sosial</h3>
        <ul class="mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-400">
          {Object.entries(institution.social_media).map(([platform, handle]) => (
            <li class="capitalize">{platform}: {handle}</li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-8 border-t border-slate-200 pt-6 text-center text-xs text-slate-500 dark:border-slate-800 dark:text-slate-500">
      {institution.footer_text ?? `© ${year} ${institution.name}. Seluruh hak cipta dilindungi.`}
    </p>
  </div>
</footer>
