---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mx-auto max-w-6xl px-4 pb-8 pt-12">
  <h1 class="text-2xl font-bold text-slate-900 dark:text-white sm:text-3xl">{title}</h1>
  {subtitle && <p class="mt-2 text-slate-600 dark:text-slate-400">{subtitle}</p>}
</div>
